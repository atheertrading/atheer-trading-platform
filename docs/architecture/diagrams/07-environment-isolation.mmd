flowchart TB
    Config[Explicit Environment Configuration]

    subgraph SIM[SIMULATION]
        SimData[Replay or Synthetic Test Dataset]
        SimEngine[Simulation Runtime]
        SimStore[(Simulation Store)]
    end

    subgraph BACKTEST[BACKTEST]
        HistData[Versioned Historical Dataset]
        BacktestEngine[Deterministic Backtest Runtime]
        BacktestStore[(Research Results)]
    end

    subgraph DEMO[DEMO]
        DemoBroker[Broker Demo API]
        DemoOMS[Demo OMS and Execution]
        DemoStore[(Demo State)]
    end

    subgraph LIVE[LIVE — Disabled by Default]
        LiveGate[Explicit Owner Authorization and Qualification Gate]
        LiveBroker[Production Broker API]
        LiveOMS[Production OMS and Execution]
        LiveStore[(Production State)]
    end

    Config --> SimEngine
    Config --> BacktestEngine
    Config --> DemoOMS
    Config --> LiveGate
    SimData --> SimEngine
    SimEngine --> SimStore
    HistData --> BacktestEngine
    BacktestEngine --> BacktestStore
    DemoBroker <--> DemoOMS
    DemoOMS --> DemoStore
    LiveGate -->|Only after all gates pass| LiveOMS
    LiveOMS <--> LiveBroker
    LiveOMS --> LiveStore
